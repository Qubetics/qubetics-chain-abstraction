# Copy to `.env` and fill in secrets before running the MPC node.

# Optional RPC port override (defaults to 8081 when unset)
# RPC_PORT=8081

# REQUIRED: 32-byte chain code secret expressed as hex (64 chars).
# Generate securely, e.g. `openssl rand -hex 32`, and keep private.
CHAIN_CODE_HEX=2919cd546f2c4338bccb4794a3d6afba2282e5729653fc2c2ff6c5e0e194abe4

# REQUIRED: Network to join (accepted values: testnet, mainnet)
# This determines both the Qubetics/Ethereum network and the Bitcoin network.
# For Bitcoin, this will be used to create the appropriate chain handler
# (Bitcoin testnet or mainnet). Set to "mainnet" for production deployments.
NETWORK_TYPE=testnet

# REQUIRED: RPC endpoint for the configured network
MPC_ETHEREUM_RPC_URL=https://rpc-testnet.qubetics.work

